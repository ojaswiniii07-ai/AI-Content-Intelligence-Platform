# ==============================================================================
# ContentIQ AI Content Intelligence Platform — Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ContentIQ Backend API"
API_V1_PREFIX=/api/v1

# Security & Authentication
# Generate a secure 32+ char key using: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Integration secret encryption key (optional: if omitted, derived from SECRET_KEY via SHA256)
INTEGRATION_ENCRYPTION_KEY=

# CORS Configuration (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL)
# Note: For async engine, SQLAlchemy uses postgresql+asyncpg://
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contentiq_db

# Optional Direct Database URL (Overrides the component credentials above if set)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contentiq_db
# For SQLite testing fallback:
# DATABASE_URL=sqlite+aiosqlite:///./test.db

# Logging
LOG_LEVEL=INFO

# ==============================================================================
# Media Analysis — Worker & Detector Configuration
# ==============================================================================

# Redis (required for Celery async workers)
REDIS_URL=redis://localhost:6379/0

# Private upload storage directory (never served as a public URL)
MEDIA_UPLOAD_DIR=./uploads/media

# Per-type file size limits (MB)
MEDIA_MAX_IMAGE_MB=20
MEDIA_MAX_AUDIO_MB=100
MEDIA_MAX_VIDEO_MB=500

# Detector backend selection
# IMAGE_DETECTOR: "hive" (requires HIVE_API_KEY) | "sightengine" (requires SIGHTENGINE_USER + SIGHTENGINE_SECRET) | "" (disabled)
IMAGE_DETECTOR=

# AUDIO_DETECTOR: "elevenlabs_detect" (requires ELEVENLABS_API_KEY) | "hive_audio" (requires HIVE_API_KEY) | "" (disabled)
AUDIO_DETECTOR=

# VIDEO_DETECTOR: "hive_video" (requires HIVE_API_KEY) | "microsoft_video" (requires AZURE_VIDEO_INDEXER_KEY + AZURE_VIDEO_INDEXER_ACCOUNT_ID) | "" (disabled)
VIDEO_DETECTOR=

# Hive Moderation API (used for image, audio, and/or video depending on IMAGE/AUDIO/VIDEO_DETECTOR above)
HIVE_API_KEY=

# SightEngine (image only)
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# ElevenLabs (audio only)
ELEVENLABS_API_KEY=

# Azure Video Indexer (video only)
AZURE_VIDEO_INDEXER_KEY=
AZURE_VIDEO_INDEXER_ACCOUNT_ID=
AZURE_VIDEO_INDEXER_LOCATION=trial

# Optional: Audio-Video consistency check (requires ffprobe on PATH)
AV_CONSISTENCY_CHECK=false
FFPROBE_PATH=ffprobe

# ==============================================================================
# Rubric-Based Evaluation Configuration
# ==============================================================================

# LLM Evaluator API Key (leave empty to disable LLM evaluator; system will not fabricate scores)
LLM_EVALUATOR_API_KEY=
LLM_EVALUATOR_PROVIDER=openai
LLM_EVALUATOR_MODEL=gpt-4o
LLM_EVALUATOR_TIMEOUT_SECONDS=30

